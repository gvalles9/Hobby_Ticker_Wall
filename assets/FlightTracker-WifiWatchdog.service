[Unit]
Description=FlightTracker Wi-Fi recovery watchdog
After=NetworkManager.service FlightTracker.service
Wants=NetworkManager.service FlightTracker.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/sbin/flighttracker-wifi-watchdog
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
